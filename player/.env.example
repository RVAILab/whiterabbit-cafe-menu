# Both endpoints are required for production builds. Development defaults to
# localhost:3000, so these may remain unset for the usual local setup.
# VITE_PROJECTED_MENU_URL=http://localhost:3000/api/projected-menu
# VITE_DISPLAY_CONTROL_URL=http://localhost:3000/api/display-control

# Sonos Server Configuration (for Now Playing widget)
# These are optional - if not set, the Now Playing widget won't appear
VITE_SONOS_SERVER_URL=https://your-sonos-server.com
VITE_SONOS_ZONE_ID=your-zone-id
VITE_SONOS_POLL_INTERVAL=3000

# Rova Calendar Configuration (for Upcoming Events widget)
# These are optional - if not set, the Upcoming widget won't appear
VITE_ROVA_API_KEY=your-rova-api-key
VITE_ROVA_VENUE_SLUG=white-rabbit-clubhouse
VITE_ROVA_POLL_INTERVAL=60000
