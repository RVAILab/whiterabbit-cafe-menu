# Sanity Configuration
# Get these values from your Sanity project settings at https://sanity.io/manage

VITE_SANITY_PROJECT_ID=7h05nytv
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2023-05-03
VITE_SANITY_TOKEN=your-read-token-here

# Sonos Server Configuration (for Now Playing widget)
# These are optional - if not set, the Now Playing widget won't appear
VITE_SONOS_SERVER_URL=https://your-sonos-server.com
VITE_SONOS_ZONE_ID=your-zone-id
VITE_SONOS_POLL_INTERVAL=3000

# Display liveness heartbeat (optional)
# Where the board posts its "I am alive" heartbeat. Defaults to the same-origin
# /api/display endpoint; set to `off` to disable the heartbeat entirely.
# VITE_DISPLAY_HEARTBEAT_ENDPOINT=off
#
# The server half needs two variables on the Vercel project (not here — they are
# secrets and must never reach the browser bundle):
#   OBSERVATORY_URL            base URL of the Agent Observatory
#   OBSERVATORY_INGEST_TOKEN   bearer token for its POST /api/runs ingest
# With either unset the heartbeat is a complete no-op.

# Rova Calendar Configuration (for Upcoming Events widget)
# These are optional - if not set, the Upcoming widget won't appear
VITE_ROVA_API_KEY=your-rova-api-key
VITE_ROVA_VENUE_SLUG=white-rabbit-clubhouse
VITE_ROVA_POLL_INTERVAL=60000
